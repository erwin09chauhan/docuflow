ConnectionStrings__DefaultConnection=your-postgresql-connection-string

Jwt__Secret=your-super-secret-key-min-32-chars
Jwt__Issuer=DocuFlow
Jwt__Audience=DocuFlow
Jwt__ExpiryMinutes=60
Jwt__RefreshTokenExpiryDays=7

Cors__AllowedOrigins=http://localhost:5173

AiProvider=Groq
Groq__ApiKey=your-groq-api-key

Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__FromAddress=noreply@docuflow.com
Email__Username=
Email__Password=

R2__AccountId=your-cloudflare-account-id
R2__AccessKeyId=your-r2-access-key-id
R2__SecretAccessKey=your-r2-secret-access-key
R2__BucketName=docuflow-uploads
